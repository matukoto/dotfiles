<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>jp.yaskkserv2</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/USERS/.local/bin/yaskkserv2</string>
        <string>--google-japanese-input=notfound</string>
        <string>--google-suggest</string>
        <string>--google-cache-filename=/Users/USERS/.skk/yaskkserv2.cache</string>
        <string>/Users/USERS/.skk/dictionary.yaskkserv2</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/yaskkserv2.out.log</string>
        <key>StandardErrorPath</key>
    <string>/tmp/yaskkserv2.err.log</string>
</dict>
</plist>
